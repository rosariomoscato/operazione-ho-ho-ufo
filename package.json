{
  "name": "operazione-ho-ho-ufo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:labs": "node tools/serve.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5175 --strictPort",
    "snapshot:m1": "node tools/serve-snapshot.mjs",
    "snapshot:m2": "node tools/serve-street-snapshot.mjs",
    "snapshot:release": "node tools/serve-release.mjs",
    "freeze:release": "node tools/freeze-release.mjs",
    "snapshot:polish": "node tools/serve-polished.mjs",
    "freeze:polish": "node tools/freeze-polish.mjs",
    "test:street": "node --test tools/street.test.mjs tools/street-runtime.test.mjs",
    "capture:street": "node tools/capture-street.mjs",
    "test:square": "node --test tools/square.test.mjs tools/square-runtime.test.mjs tools/square-storage.test.mjs",
    "check:square": "node tools/check-square.mjs",
    "capture:square": "node tools/capture-square.mjs",
    "capture:polish": "node tools/capture-polish.mjs",
    "test:playthrough": "node tools/full-playthrough.mjs",
    "capture": "node tools/capture.mjs tools/testscene.html --times 0,2.4,5 --views diorama,fp --out captures/testscene --selftest",
    "test": "node --test tools/capture.test.mjs tools/audio/audio.test.mjs tools/game.test.mjs tools/polish-settings.test.mjs tools/polish-input.test.mjs tools/street.test.mjs tools/street-runtime.test.mjs tools/square.test.mjs tools/square-runtime.test.mjs tools/square-storage.test.mjs tools/release.test.mjs",
    "audio:plan": "node tools/gen-audio.mjs tools/audio/manifest/opening.json --dry-run",
    "audio:build": "node tools/gen-audio.mjs tools/audio/manifest/opening.json"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
